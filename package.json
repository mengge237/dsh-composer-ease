{
  "name": "dsh-composer-ease",
  "version": "0.9.43",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY.md"
  ],
  "dsh": {
    "compatibility": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "check:size": "node tools/check-size.mjs",
    "check:dup": "node tools/check-dup.mjs",
    "check:refactor": "node tools/check-refactor.mjs",
    "check": "node tools/check-size.mjs && node tools/check-dup.mjs && node tools/check-refactor.mjs && node tools/check-release.mjs",
    "test": "node tools/check-size.mjs && node tools/check-dup.mjs && node test/selftest.mjs && node test/server-routes.mjs && node test/client-smoke.mjs && node test/client-behavior.mjs && node test/compliance.mjs",
    "sync:host": "node tools/sync-host.mjs",
    "check:host": "node tools/sync-host.mjs --check",
    "check:docs": "node tools/check-docs.mjs",
    "check:all": "npm run check && npm run check:docs && npm run check:privacy && npm run check:prose && npm run check:copies && npm run build -- --check",
    "record:demo": "node tools/record-demo.mjs",
    "check:copies": "node tools/copies.mjs --check",
    "sync:copies": "node tools/copies.mjs --sync",
    "link:host": "node tools/link-host.mjs",
    "check:prose": "node tools/verify-comment-prose.mjs",
    "check:privacy": "node tools/check-privacy.mjs",
    "scrub:public": "node tools/scrub-public.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
